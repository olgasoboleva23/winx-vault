formulas:
  coverImageFormula: file.embeds[0]
  stars: if(rating, "★".repeat(rating) + "☆".repeat(10 - rating), "")
properties:
  formula.stars:
    displayName: rating
  note.rating:
    displayName: 1–10
views:
  - type: cards
    name: Cards
    filters:
      and:
        - type == "game"
    order:
      - file.name
      - formula.stars
      - status
      - genre
      - tags
    image: formula.coverImageFormula
  - type: table
    name: Table
    filters:
      and:
        - type == "game"
    order:
      - file.name
      - status
      - genre
      - hours
      - rating
      - formula.stars
