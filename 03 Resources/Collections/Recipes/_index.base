formulas:
  coverImageFormula: file.embeds[0]
  stars: if(rating, "★".repeat(rating) + "☆".repeat(10 - rating), "")
properties:
  formula.stars:
    displayName: rating
  note.rating:
    displayName: 1–10
views:
  - type: cards
    name: Cards
    filters:
      and:
        - type == "recipe"
    order:
      - name
      - formula.stars
      - time
      - difficulty
      - tags
    sort:
      - property: name
        direction: ASC
    image: formula.coverImageFormula
  - type: table
    name: Table
    filters:
      and:
        - type == "recipe"
    order:
      - name
      - time
      - difficulty
      - rating
      - formula.stars
